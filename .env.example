# Copy this file to .env and fill in your own values.
# Never commit your real .env file (it holds API secrets) — this project's
# .gitignore already excludes .env, but double-check before pushing anywhere.

# ==================== EXCHANGE API ====================
# Leave blank to run in 'paper' mode with no API keys at all.
# For 'demo':    get keys from https://demo.binance.com (log in with your
#                real Binance account, then Binance Demo Trading > API Key
#                Management). Simulated funds — see README for full steps.
# For 'testnet': get free keys at https://testnet.binance.vision
# This project is demo-only — grant these keys trading permission only,
# never withdrawals, as standard practice even though it's simulated money.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ==================== TRADING SETTINGS ====================
# paper   = simulated fills using real public market data, no orders actually
#           placed, no API keys needed
# demo    = real orders against Binance Spot Demo Mode (simulated funds,
#           market data/rules matching the live exchange)
# testnet = real orders against Binance Spot Testnet (simulated funds,
#           independent/synthetic market data)
#
# 'live' is NOT a supported value — this project is scoped to demo-only
# trading, and the app refuses to start if this is set to 'live'.
TRADING_MODE=paper
SYMBOL=BTCUSDT
TIMEFRAME=15m

# ==================== OPERATIONAL ====================
CHECK_INTERVAL_SECONDS=60
MAX_RETRIES=3
RETRY_DELAY_SECONDS=5
CIRCUIT_BREAKER_THRESHOLD=5
MAX_SLIPPAGE_PERCENT=0.5

# ==================== BACKTEST ====================
BACKTEST_INITIAL_CAPITAL=10000

# ==================== LOGGING ====================
LOG_LEVEL=INFO
LOG_FILE=logs/trading_bot.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
